# Exemple Nginx — domaine canonique https://leroydudebaras.fr (apex, sans www)
# Appliquer sur le VPS puis : nginx -t && systemctl reload nginx

# 1) HTTP → HTTPS + www → apex
server {
    listen 80;
    listen [::]:80;
    server_name leroydudebaras.fr www.leroydudebaras.fr;
    return 301 https://leroydudebaras.fr$request_uri;
}

# 2) HTTPS www → apex
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.leroydudebaras.fr;

    # ssl_certificate / etc. (certbot)

    return 301 https://leroydudebaras.fr$request_uri;
}

# 3) Site canonique
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name leroydudebaras.fr;
    root /var/www/LEROY_DEBARRAS;
    index index.html;

    # ssl_certificate / etc. (certbot)

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    charset utf-8;
    server_tokens off;

    error_page 404 /404.html;

    # /index.html → /
    location = /index.html {
        return 301 /;
    }

    # Ancienne URL
    location = /elagage.html {
        return 301 /nettoyage-exterieur.html;
    }

    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
